<Window x:Class="WpfApp1.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinAudioBridge 设置"
        Icon="Assets/app.ico"
        Height="820"
        Width="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Loaded="SettingsWindow_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock VerticalAlignment="Center" Text="编码" />
            <ComboBox x:Name="EncodingComboBox" Grid.Column="2" MinWidth="180" />

            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="采样率" />
            <ComboBox x:Name="SampleRateComboBox" Grid.Row="2" Grid.Column="2" MinWidth="180" />

            <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="声道数" />
            <ComboBox x:Name="ChannelsComboBox" Grid.Row="4" Grid.Column="2" MinWidth="180" />

            <TextBlock Grid.Row="6" VerticalAlignment="Center" Text="Buffer 大小" />
            <ComboBox x:Name="BufferComboBox" Grid.Row="6" Grid.Column="2" MinWidth="180" />

            <TextBlock Grid.Row="8" VerticalAlignment="Center" Text="Android 应用包名" />
            <TextBox x:Name="AndroidPackageNameTextBox" Grid.Row="8" Grid.Column="2" MinWidth="180" />

            <TextBlock Grid.Row="10" VerticalAlignment="Center" Text="自动重连" />
            <CheckBox x:Name="EnableAutoReconnectCheckBox"
                      Grid.Row="10"
                      Grid.Column="2"
                      VerticalAlignment="Center"
                      Content="启动后自动连接、配置修改后自动重连，并在断开后持续尝试重连" />

            <TextBlock Grid.Row="12" VerticalAlignment="Center" Text="连接模式" />
            <ComboBox x:Name="ConnectionModeComboBox" Grid.Row="12" Grid.Column="2" MinWidth="180" />

            <TextBlock Grid.Row="14" VerticalAlignment="Center" Text="LAN 监听端口" />
            <TextBox x:Name="LanListenPortTextBox" Grid.Row="14" Grid.Column="2" MinWidth="180" />

            <TextBlock Grid.Row="16" VerticalAlignment="Center" Text="局域网发现" />
            <CheckBox x:Name="EnableLanDiscoveryCheckBox"
                      Grid.Row="16"
                      Grid.Column="2"
                      VerticalAlignment="Center"
                      Content="响应 Android 端发现的探测广播（仅局域网模式生效）" />

            <TextBlock Grid.Row="18" VerticalAlignment="Center" Text="延迟显示" />
            <CheckBox x:Name="EnableLatencyDisplayCheckBox"
                      Grid.Row="18"
                      Grid.Column="2"
                      VerticalAlignment="Center"
                      Content="测量并显示音频传输延迟（估算值）" />

            <TextBlock Grid.Row="20"
                       Grid.ColumnSpan="3"
                       Foreground="#666"
                       TextWrapping="Wrap"
                       Text="连接模式：ADB 使用 USB + adb reverse，LAN 使用局域网直连（Windows 作服务器，Android 客户端主动连接）。" />

            <Border x:Name="DeviceFormatBorder"
                    Grid.Row="22"
                    Grid.ColumnSpan="3"
                    Padding="12,8"
                    CornerRadius="6"
                    Background="#F5F5F5"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="系统音频设备原生格式" />
                    <TextBlock x:Name="DeviceFormatTextBlock"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Text="正在检测..." />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Padding="16"
                Background="#F8F8F8"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" FontSize="16" FontWeight="SemiBold" Text="已连接 Android 设备" />
                    <Button x:Name="RefreshDevicesButton"
                            Width="100"
                            HorizontalAlignment="Right"
                            Click="RefreshDevices_Click">刷新设备</Button>
                </DockPanel>

                <TextBlock x:Name="DeviceStatusTextBlock"
                           Grid.Row="2"
                           Foreground="#666"
                           Text="正在准备设备查询..." />

                <TextBlock x:Name="SelectedDeviceTextBlock"
                           Grid.Row="4"
                           Foreground="#666"
                           Text="当前未指定优先设备，将自动选择可用设备。" />

                <ListView x:Name="DevicesListView" Grid.Row="6" Margin="0,4,0,0" SelectionChanged="DevicesListView_SelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="220" DisplayMemberBinding="{Binding Model}" Header="设备名称" />
                            <GridViewColumn Width="170" DisplayMemberBinding="{Binding Serial}" Header="序列号" />
                            <GridViewColumn Width="120" DisplayMemberBinding="{Binding State}" Header="连接状态" />
                            <GridViewColumn Width="120" DisplayMemberBinding="{Binding AppStatusText}" Header="音频应用状态" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="90" Margin="0,0,8,0" Click="ResetDefaults_Click">恢复默认值</Button>
            <Button Width="90" Margin="0,0,8,0" Click="Cancel_Click">取消</Button>
            <Button Width="90" Click="Save_Click">保存</Button>
        </StackPanel>
    </Grid>
</Window>
